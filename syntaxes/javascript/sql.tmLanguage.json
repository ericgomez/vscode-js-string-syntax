{
  "scopeName": "source.js.sql",
  "injectionSelector": "L:source.js -comment -(string -meta.embedded), L:source.jsx -comment -(string -meta.embedded), L:source.js.jsx -comment -(string -meta.embedded)",
  "patterns": [
    {
      "include": "#sql-string-double-quoted"
    },
    {
      "include": "#sql-string-single-quoted"
    },
    {
      "include": "#sql-string-template"
    }
  ],
  "repository": {
    "sql-string-double-quoted": {
      "begin": "(/\\*\\s?sql\\s?\\*/)\\s*(\")",
      "beginCaptures": {
        "1": {
          "name": "comment.block.js"
        },
        "2": {
          "name": "punctuation.definition.string.begin.js"
        }
      },
      "end": "(\")",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.js"
        }
      },
      "name": "string.quoted.double.js",
      "patterns": [
        {
          "begin": "(?<=\")",
          "contentName": "source.sql.embedded.js",
          "end": "(?=\")",
          "name": "string.quoted.double.sql.js",
          "patterns": [
            {
              "include": "source.js#string-character-escape"
            },
            {
              "match": "(#)(\\\\\"|[^\"])*(?=\"|$)",
              "name": "comment.line.number-sign.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "match": "(--)(\\\\\"|[^\"])*(?=\"|$)",
              "name": "comment.line.double-dash.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "match": "'(?=((\\\\')|[^'\"])*(\"|$))",
              "name": "string.quoted.single.unclosed.sql"
            },
            {
              "match": "`(?=((\\\\`)|[^`\"])*(\"|$))",
              "name": "string.quoted.other.backtick.unclosed.sql"
            },
            {
              "include": "source.sql"
            }
          ]
        }
      ]
    },
    "sql-string-single-quoted": {
      "begin": "(/\\*\\s?sql\\s?\\*/)\\s*(')",
      "beginCaptures": {
        "1": {
          "name": "comment.block.js"
        },
        "2": {
          "name": "punctuation.definition.string.begin.js"
        }
      },
      "end": "(')",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.end.js"
        }
      },
      "name": "string.quoted.single.js",
      "patterns": [
        {
          "begin": "(?<=')",
          "contentName": "source.sql.embedded.js",
          "end": "(?=')",
          "name": "string.quoted.single.sql.js",
          "patterns": [
            {
              "include": "source.js#string-character-escape"
            },
            {
              "match": "(#)(\\\\'|[^'])*(?='|$)",
              "name": "comment.line.number-sign.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "match": "(--)(\\\\'|[^'])*(?='|$)",
              "name": "comment.line.double-dash.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "match": "`(?=((\\\\`)|[^`'])*('|$))",
              "name": "string.quoted.other.backtick.unclosed.sql"
            },
            {
              "match": "\"(?=((\\\\\")|[^\"'])*('|$))",
              "name": "string.quoted.double.unclosed.sql"
            },
            {
              "include": "source.sql"
            }
          ]
        }
      ]
    },
    "sql-string-template": {
      "begin": "(/\\*\\s?sql\\s?\\*/)\\s*(`)",
      "beginCaptures": {
        "1": {
          "name": "comment.block.js"
        },
        "2": {
          "name": "punctuation.definition.string.template.begin.js"
        }
      },
      "end": "(`)",
      "endCaptures": {
        "1": {
          "name": "punctuation.definition.string.template.end.js"
        }
      },
      "name": "string.template.js",
      "patterns": [
        {
          "begin": "(?<=`)",
          "contentName": "source.sql.embedded.js",
          "end": "(?=`)",
          "name": "string.template.sql.js",
          "patterns": [
            {
              "match": "(#)(\\\\`|[^`])*(?=`|$)",
              "name": "comment.line.number-sign.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "match": "(--)(\\\\`|[^`])*(?=`|$)",
              "name": "comment.line.double-dash.sql",
              "captures": {
                "1": {
                  "name": "punctuation.definition.comment.sql"
                }
              }
            },
            {
              "begin": "'",
              "end": "'",
              "name": "string.quoted.single.sql",
              "patterns": [
                {
                  "include": "source.js#template-substitution-element"
                }
              ]
            },
            {
              "begin": "\"",
              "end": "\"",
              "name": "string.quoted.double.sql",
              "patterns": [
                {
                  "include": "source.js#template-substitution-element"
                }
              ]
            },
            {
              "include": "source.js#template-substitution-element"
            },
            {
              "include": "source.js#string-character-escape"
            },
            {
              "include": "source.sql"
            }
          ]
        }
      ]
    }
  }
}